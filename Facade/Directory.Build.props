<Project>

  <!-- Common settings for every project in the Facade C# solution. Each project overrides
       RootNamespace with its own subsystem, because this folder holds three independent
       examples rather than one library. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>dev.kaldiroglu.Facade</RootNamespace>
  </PropertyGroup>

</Project>
