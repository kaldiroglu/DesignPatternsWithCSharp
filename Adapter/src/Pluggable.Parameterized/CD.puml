interface TurkishPowerSource <<Target>> {
  +turnOn()
  +turnOff()
}

class PluggablePowerAdapter <<Adapter>> {
  -onTurnOn : Runnable
  -onTurnOff : Runnable
  +turnOn()
  +turnOff()
}

interface Runnable <<block>> {
  +run()
}

class USPowerSource <<Adaptee>> {
  +pushSwitch()
}

class UKPowerSource <<Adaptee>> {
  +flipToggle()
}

class KenyaPowerSource <<Adaptee>> {
  +hakunaMatata()
}

TurkishPowerSource <|.. PluggablePowerAdapter

note bottom of PluggablePowerAdapter
  One adapter class; the narrow interface is
  supplied as Runnable object. Each Runnable object is
  a lambda expression (or a method reference) to an adaptee, e.g.
  new PluggablePowerAdapter(us::pushSwitch, us::pushSwitch)
end note

PluggablePowerAdapter o-[norank]-> "2" Runnable : lambdas
USPowerSource .[dashed,norank].> Runnable : us::pushSwitch
UKPowerSource .[dashed,norank].> Runnable : uk::flipToggle
KenyaPowerSource .[dashed,norank].> Runnable : ke::hakunaMatata
