    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>dev.kaldiroglu.Adapter</RootNamespace>
  </PropertyGroup>

</Project>
