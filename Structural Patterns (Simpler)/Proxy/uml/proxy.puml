@startuml Proxy
skinparam classAttributeIconSize 0
title Proxy — Simpler example (C#)

interface IImage {
  + Display() : void
}

class RealImage {
  - _path : string
  + RealImage(path : string)
  - LoadFromDisk() : void
  + Display() : void
}

class ImageProxy {
  - _path : string
  - _real : RealImage?
  + ImageProxy(path : string)
  + Display() : void
}

class SolutionDemo {
  + Run() : void
}

IImage <|.. RealImage
IImage <|.. ImageProxy
ImageProxy o--> RealImage : _real (lazy)
SolutionDemo ..> IImage

note right of IImage : Subject
note bottom of RealImage : RealSubject
note bottom of ImageProxy : Proxy (virtual / lazy loading)
note bottom of SolutionDemo : Client

@enduml
