@startuml Facade
skinparam classAttributeIconSize 0
title Facade — Simpler example (C#)

class HomeTheaterFacade {
  - _amp : Amplifier
  - _dvd : DvdPlayer
  - _projector : Projector
  - _screen : Screen
  - _lights : Lights
  + HomeTheaterFacade(amp, dvd, projector, screen, lights)
  + WatchMovie(movie : string) : void
  + EndMovie() : void
}

class Amplifier {
  + On() : void
  + Off() : void
  + SetSurroundSound() : void
  + SetVolume(level : int) : void
}

class DvdPlayer {
  + On() : void
  + Off() : void
  + Play(movie : string) : void
  + Stop() : void
}

class Projector {
  + On() : void
  + Off() : void
  + WideScreenMode() : void
}

class Screen {
  + Down() : void
  + Up() : void
}

class Lights {
  + Dim(level : int) : void
  + On() : void
}

class SolutionDemo {
  + Run() : void
}

HomeTheaterFacade o--> Amplifier : _amp
HomeTheaterFacade o--> DvdPlayer : _dvd
HomeTheaterFacade o--> Projector : _projector
HomeTheaterFacade o--> Screen : _screen
HomeTheaterFacade o--> Lights : _lights
SolutionDemo ..> HomeTheaterFacade

note right of HomeTheaterFacade : Facade
note bottom of Amplifier : Subsystem
note bottom of DvdPlayer : Subsystem
note bottom of Projector : Subsystem
note bottom of Screen : Subsystem
note bottom of Lights : Subsystem
note bottom of SolutionDemo : Client

@enduml
