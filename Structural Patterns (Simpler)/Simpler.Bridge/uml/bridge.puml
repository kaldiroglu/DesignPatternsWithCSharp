@startuml Bridge
skinparam linetype polyline
skinparam class {
  BackgroundColor<<spacer>> transparent
  BorderColor<<spacer>> transparent
  FontColor<<spacer>> transparent
}
hide <<spacer>> stereotype
hide <<spacer>> circle
skinparam classAttributeIconSize 0
title Bridge — Simpler example (C#)

interface IColor {
  + ApplyColor() : string
}

class RedColor {
  + ApplyColor() : string
}

class BlueColor {
  + ApplyColor() : string
}

abstract class Shape {
  # Color : IColor
  # Shape(color : IColor)
  + {abstract} Draw() : void
}

class Circle {
  + Circle(color : IColor)
  + Draw() : void
}

class Square {
  + Square(color : IColor)
  + Draw() : void
}

class SolutionDemo {
  + Run() : void
}

IColor <|.. RedColor
IColor <|.. BlueColor
Shape <|-- Circle
Shape <|-- Square

note right of Shape : Abstraction
note bottom of Circle : RefinedAbstraction
note bottom of Square : RefinedAbstraction
note right of IColor : Implementor
note left of RedColor : ConcreteImplementor
note left of BlueColor : ConcreteImplementor
note bottom of SolutionDemo : Client

class " " as Spacer1 <<spacer>>
IColor -[hidden]- Spacer1
IColor -[hidden]- Spacer1
RedColor -[hidden]right- Spacer1
Spacer1 -[hidden]right- BlueColor
class " " as Spacer2 <<spacer>>
Shape -[hidden]- Spacer2
Shape -[hidden]- Spacer2
Circle -[hidden]right- Spacer2
Spacer2 -[hidden]right- Square
Shape o-[norank]-> IColor : Color (bridge)
SolutionDemo .[norank].> Shape
@enduml
