@startuml Decorator
skinparam linetype polyline
skinparam nodesep 70
skinparam class {
  BackgroundColor<<spacer>> transparent
  BorderColor<<spacer>> transparent
  FontColor<<spacer>> transparent
}
hide <<spacer>> stereotype
hide <<spacer>> circle
skinparam classAttributeIconSize 0
title Decorator — Simpler example (C#)

interface ICoffee {
  + Description() : string
  + Cost() : decimal
}

class SimpleCoffee {
  + Description() : string
  + Cost() : decimal
}

abstract class CoffeeDecorator {
  # Wrapped : ICoffee
  # CoffeeDecorator(wrapped : ICoffee)
  + Description() : string
  + Cost() : decimal
}

class MilkDecorator {
  + MilkDecorator(wrapped : ICoffee)
  + Description() : string
  + Cost() : decimal
}

class SugarDecorator {
  + SugarDecorator(wrapped : ICoffee)
  + Description() : string
  + Cost() : decimal
}

class VanillaDecorator {
  + VanillaDecorator(wrapped : ICoffee)
  + Description() : string
  + Cost() : decimal
}

class SolutionDemo {
  + Run() : void
}

ICoffee <|.. SimpleCoffee
ICoffee <|.. CoffeeDecorator
CoffeeDecorator <|-- MilkDecorator
CoffeeDecorator <|-- SugarDecorator
CoffeeDecorator <|-- VanillaDecorator

note right of ICoffee : Component
note bottom of SimpleCoffee : ConcreteComponent
note right of CoffeeDecorator : Decorator
note bottom of MilkDecorator : ConcreteDecorator
note bottom of SugarDecorator : ConcreteDecorator
note bottom of VanillaDecorator : ConcreteDecorator
note bottom of SolutionDemo : Client

class " " as Spacer1 <<spacer>>
ICoffee -[hidden]- Spacer1
ICoffee -[hidden]- Spacer1
CoffeeDecorator -[hidden]right- Spacer1
Spacer1 -[hidden]right- SimpleCoffee
CoffeeDecorator -[hidden]- SugarDecorator
CoffeeDecorator -[hidden]- SugarDecorator
MilkDecorator -[hidden]right- SugarDecorator
SugarDecorator -[hidden]right- VanillaDecorator
CoffeeDecorator o-[norank]-> ICoffee : Wrapped
SolutionDemo .[norank].> ICoffee
@enduml
