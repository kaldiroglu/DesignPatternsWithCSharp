@startuml Adapter
skinparam linetype polyline
skinparam nodesep 70
skinparam class {
  BackgroundColor<<spacer>> transparent
  BorderColor<<spacer>> transparent
  FontColor<<spacer>> transparent
}
hide <<spacer>> stereotype
hide <<spacer>> circle
skinparam classAttributeIconSize 0
title Adapter — Simpler example (C#)

interface IMediaPlayer {
  + Play(type : string, fileName : string) : void
}

interface IAdvancedMediaPlayer {
  + PlayVlc(fileName : string) : void
  + PlayMp4(fileName : string) : void
}

class VlcPlayer {
  + PlayVlc(fileName : string) : void
  + PlayMp4(fileName : string) : void
}

class Mp4Player {
  + PlayVlc(fileName : string) : void
  + PlayMp4(fileName : string) : void
}

class MediaAdapter {
  - _advanced : IAdvancedMediaPlayer
  + MediaAdapter(type : string)
  + Play(type : string, fileName : string) : void
}

class AudioPlayer {
  + Play(type : string, fileName : string) : void
}

class SolutionDemo {
  + Run() : void
}

IMediaPlayer <|.. MediaAdapter
IMediaPlayer <|.. AudioPlayer
IAdvancedMediaPlayer <|.. VlcPlayer
IAdvancedMediaPlayer <|.. Mp4Player

note right of IMediaPlayer : Target
note right of MediaAdapter : Adapter
note right of IAdvancedMediaPlayer : Adaptee interface
note bottom of VlcPlayer : Adaptee
note bottom of Mp4Player : Adaptee
note bottom of SolutionDemo : Client

class " " as Spacer1 <<spacer>>
IMediaPlayer -[hidden]- Spacer1
IMediaPlayer -[hidden]- Spacer1
MediaAdapter -[hidden]right- Spacer1
Spacer1 -[hidden]right- AudioPlayer
class " " as Spacer2 <<spacer>>
IAdvancedMediaPlayer -[hidden]- Spacer2
IAdvancedMediaPlayer -[hidden]- Spacer2
VlcPlayer -[hidden]right- Spacer2
Spacer2 -[hidden]right- Mp4Player
